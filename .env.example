NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://soms:soms@localhost:5432/soms
TEST_DATABASE_URL=postgres://soms:soms@localhost:5432/soms_test
SESSION_SECRET=change-me-in-production-use-64-random-chars-minimum-for-security
# CRA dev server (frontend npm start) uses port 3000
CORS_ORIGIN=http://localhost:3000
APP_TIMEZONE=Asia/Kolkata
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_BYTES=5242880
RESERVATION_HOLD_MINUTES=15
AUTOPAY_PENDING_TIMEOUT_HOURS=24
PRICING_COMBINATION_MODE=BEST_OF
COLLEGE_VERIFICATION_MODE=mock
VERIFICATION_HASH_KEY=dev-verification-hmac-key-change-in-prod
NOTIFY_MODE=dev
DEV_NOTIFY_FAIL_CHANNEL=
SIM_AUTOPAY_OUTCOME=SUCCEEDED
DEV_TOOLS_ENABLED=true
SEED_ON_START=true
JOBS_ENABLED=true
# Low-stock alert threshold used when a size has none of its own.
DEFAULT_LOW_STOCK_THRESHOLD=5
# Tests set false (the authorization matrices exceed 300 requests/minute); keep true elsewhere.
RATE_LIMIT_ENABLED=true
# Knex pool size per backend process (tests use 30).
DATABASE_POOL_MAX=10
